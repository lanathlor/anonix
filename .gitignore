# Build artifacts
result
result-*
*.qcow2

# Generated by `just sbom` / `just audit` (see justfile)
sbom.cdx.json
sbom.spdx.json
sbom.csv
vulns.json

# Encrypted agenix secrets (secrets/*.age) and secrets/secrets.nix ARE meant to
# be committed. Only ever exclude PLAINTEXT keys/identities:
*.key
!*.key.age
age-identity
age-identity.*
*.priv
mullvad*.conf

# Editor/tool state and shell dotfiles (sandbox artifacts, not project files)
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
.mcp.json
.profile
.ripgreprc
.vscode
.zprofile
.zshrc
